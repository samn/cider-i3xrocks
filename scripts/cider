#!/bin/bash
# i3xrocks blocklet for Cider (Apple Music)
# Displays currently playing track. Left-click toggles play/pause.
# Requires: curl, jq, xrescat
# Token: ~/.config/cider-i3xrocks/token (plain text, mode 600)

# Read API token
TOKEN_FILE="${HOME}/.config/cider-i3xrocks/token"
[[ -f "$TOKEN_FILE" ]] || exit 0
TOKEN="$(<"$TOKEN_FILE")"
TOKEN="${TOKEN#"${TOKEN%%[![:space:]]*}"}"
TOKEN="${TOKEN%"${TOKEN##*[![:space:]]}"}"
[[ -n "$TOKEN" ]] || exit 0

CIDER_URL="http://localhost:10767"
CURL_OPTS=(--max-time 1 -sf)
AUTH_HEADER="apitoken: ${TOKEN}"

# Check Cider is running
HTTP_CODE=$(curl "${CURL_OPTS[@]}" -o /dev/null -w "%{http_code}" \
  -H "$AUTH_HEADER" "$CIDER_URL/api/v1/playback/active" 2>/dev/null)
[[ "$HTTP_CODE" == "204" ]] || exit 0

# Handle left-click: toggle play/pause
if [[ "${button:-}" == "1" ]]; then
  curl "${CURL_OPTS[@]}" -X POST \
    -H "$AUTH_HEADER" "$CIDER_URL/api/v1/playback/playpause" >/dev/null 2>&1
  sleep 0.1
fi

# Check if playing
IS_PLAYING=$(curl "${CURL_OPTS[@]}" \
  -H "$AUTH_HEADER" "$CIDER_URL/api/v1/playback/is-playing" 2>/dev/null)
[[ "$IS_PLAYING" == "true" ]] || exit 0

# Get now-playing info
NOW_PLAYING=$(curl "${CURL_OPTS[@]}" \
  -H "$AUTH_HEADER" "$CIDER_URL/api/v1/playback/now-playing" 2>/dev/null)
[[ -n "$NOW_PLAYING" ]] || exit 0

ARTIST=$(printf '%s' "$NOW_PLAYING" | jq -r '.info.artistName // empty')
SONG=$(printf '%s' "$NOW_PLAYING" | jq -r '.info.name // empty')
[[ -n "$ARTIST" && -n "$SONG" ]] || exit 0

# Theming via xrescat with defaults
LABEL_ICON=${icon:-$(xrescat i3xrocks.label.cider "♫")}
LABEL_COLOR=${label_color:-$(xrescat i3xrocks.label.color "#7B8394")}
VALUE_COLOR=${color:-$(xrescat i3xrocks.value.color "#D8DEE9")}
VALUE_FONT=${font:-$(xrescat i3xrocks.value.font "Source Code Pro Medium 13")}
MAX_LENGTH=${max_length:-$(xrescat i3xrocks.cider.maxlength 40)}

# Build display string and truncate if needed
DISPLAY="${ARTIST} - ${SONG}"
if [[ ${#DISPLAY} -gt $MAX_LENGTH ]]; then
  DISPLAY="${DISPLAY:0:$((MAX_LENGTH - 1))}…"
fi

# Escape Pango special characters
DISPLAY="${DISPLAY//&/&amp;}"
DISPLAY="${DISPLAY//</&lt;}"
DISPLAY="${DISPLAY//>/&gt;}"

echo "<span font_desc=\"${VALUE_FONT}\" color=\"${LABEL_COLOR}\">${LABEL_ICON}</span><span font_desc=\"${VALUE_FONT}\" color=\"${VALUE_COLOR}\"> ${DISPLAY}</span>"
