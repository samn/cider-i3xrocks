#!/bin/bash
# i3xrocks blocklet for Cider (Apple Music)
# Displays currently playing track.
# Requires: curl, jq, xrescat
# Token: ~/.config/cider-i3xrocks/token (plain text, mode 600)

# Read API token (optional — Cider can be configured to not require one)
TOKEN_FILE="${HOME}/.config/cider-i3xrocks/token"
TOKEN=""
if [[ -f "$TOKEN_FILE" ]]; then
  TOKEN="$(<"$TOKEN_FILE")"
  TOKEN="${TOKEN#"${TOKEN%%[![:space:]]*}"}"
  TOKEN="${TOKEN%"${TOKEN##*[![:space:]]}"}"
fi

CIDER_URL="http://localhost:10767"
CURL_OPTS=(--max-time 1 -sf)
AUTH_ARGS=()
if [[ -n "$TOKEN" ]]; then
  AUTH_ARGS=(-H "apitoken: ${TOKEN}")
fi

# Cache last output so the block doesn't flicker on slow responses.
# Only used when curl times out (Cider is running but slow); cleared otherwise.
CACHE_FILE="${XDG_RUNTIME_DIR:-/tmp}/cider-i3xrocks-cache"
clear_cache() { rm -f "$CACHE_FILE"; }
show_cached() { [[ -f "$CACHE_FILE" ]] && cat "$CACHE_FILE"; exit 0; }

# Get now-playing info (single call — covers active check + playing check + track info)
NOW_PLAYING=$(curl "${CURL_OPTS[@]}" \
  "${AUTH_ARGS[@]}" "$CIDER_URL/api/v1/playback/now-playing" 2>/dev/null)
CURL_EXIT=$?

# Exit code 28 = timeout (Cider is running but slow) — show cached output
# Any other failure (7 = connection refused, etc.) = Cider not running — clear cache
if [[ -z "$NOW_PLAYING" ]]; then
  if [[ $CURL_EXIT -eq 28 ]]; then
    show_cached
  fi
  clear_cache
  exit 0
fi

ARTIST=$(printf '%s' "$NOW_PLAYING" | jq -r '.info.artistName // empty')
SONG=$(printf '%s' "$NOW_PLAYING" | jq -r '.info.name // empty')
if [[ -z "$ARTIST" || -z "$SONG" ]]; then
  clear_cache
  exit 0
fi

# Theming via xrescat with defaults
LABEL_ICON=${icon:-$(xrescat i3xrocks.label.cider "♫")}
LABEL_COLOR=${label_color:-$(xrescat i3xrocks.label.color "#7B8394")}
VALUE_COLOR=${color:-$(xrescat i3xrocks.value.color "#D8DEE9")}
VALUE_FONT=${font:-$(xrescat i3xrocks.value.font "Source Code Pro Medium 13")}
MAX_LENGTH=${max_length:-$(xrescat i3xrocks.cider.maxlength 40)}

# Build display string and truncate if needed
DISPLAY="${ARTIST} - ${SONG}"
if [[ ${#DISPLAY} -gt $MAX_LENGTH ]]; then
  DISPLAY="${DISPLAY:0:$((MAX_LENGTH - 1))}…"
fi

# Escape Pango special characters
DISPLAY="${DISPLAY//&/&amp;}"
DISPLAY="${DISPLAY//</&lt;}"
DISPLAY="${DISPLAY//>/&gt;}"

OUTPUT="<span font_desc=\"${VALUE_FONT}\" color=\"${LABEL_COLOR}\">${LABEL_ICON}</span><span font_desc=\"${VALUE_FONT}\" color=\"${VALUE_COLOR}\"> ${DISPLAY}</span>"
printf '%s\n' "$OUTPUT" > "$CACHE_FILE"
echo "$OUTPUT"
